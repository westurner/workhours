{% if wrap %}
{% extends "base.jinja2" %}
{% endif %}
{% block extracss %}
<link rel="stylesheet" href="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.css" integrity="sha384-vj+oeQOya41RCCkuDHsW3E5i5fEHhKBSF4R/6D4fOACzhlFXfoDv5V/IBuCr0VZZ" crossorigin="anonymous">
{% endblock extracss %}
{% block extrajs %}
<script src="https://cdn.datatables.net/v/dt/dt-3.1.4/datatables.min.js" integrity="sha384-xlyM0nIE4duzZdmWdeEmvc9HGr7nterdFl+X+9ADR3gSNfdfQFG85gsPQ02DKxM9" crossorigin="anonymous"></script>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", function () {
    const table = document.getElementById("{{ table_id }}");
    if (!table) {
        return;
    }

    new DataTable(table, {
        ordering: true,
        paging: true,
        lengthChange: true,
        searching: true,
        autoWidth: false,
        pageLength: 20,
        lengthMenu: [20, 50, 100, 1000, 2000, -1],
        {% if not no_json %}
        processing: true,
        serverSide: true,
        ajax: {
            url: "/api/{{ table_id }}.json",
            dataSrc: "results"
        },
        scrollCollapse: true,
        scrollY: "400px",
        scrollX: true,
        {% endif %}
        stateSave: true,
        columns: {%- block datatable_columns -%}
            {{ fields_json|skipautoescape }}
        {%- endblock datatable_columns -%}
    });
}); 
</script>
{% endblock extrajs %}


{% block contentframe %}
{% include "models/templates/_table.jinja2" %}
{% endblock contentframe %}
