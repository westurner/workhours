{% extends "models/templates/_datatable.jinja2" %}
{% block datatable_columns %}
[
{ 
    "data": "_id",
    "width": "1px",
    "render": function (data, type) {
        if (type !== "display") return data;
        const link = document.createElement("a");
        link.href = "/api/places/" + encodeURIComponent(data);
        link.textContent = data ?? "";
        return link;
    }
},
{
    "data": "url",
    "width": "70%",
    "render": function (data, type, row) {
        if (type !== "display") return data;
        const content = document.createElement("span");
        if (row.title) {
            const title = document.createElement("strong");
            title.textContent = row.title;
            content.append(title, document.createElement("br"));
        }

        const urlText = data ?? "";
        let url;
        try {
            url = new URL(urlText, window.location.href);
        } catch (error) {
            content.append(document.createTextNode(urlText));
            return content;
        }
        if (url.protocol === "http:" || url.protocol === "https:") {
            const link = document.createElement("a");
            link.href = url.href;
            link.textContent = urlText;
            content.append(link);
        } else {
            content.append(document.createTextNode(urlText));
        }
        content.append(document.createElement("br"));
        const netloc = document.createElement("span");
        netloc.textContent = row.netloc ?? "";
        content.append(netloc);
        return content;
    }
},
{ 
    "data": "netloc",
    "visible": false,
    "width": "200px"
},
{
    "data": "eventcount",
    "visible": true,
    "width": "30%"
},
{
    "data": "title",
    "visible": false,
    "width": "200px"
},
]
{% endblock datatable_columns %}
