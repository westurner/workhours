{% extends "models/templates/_datatable.jinja2" %}
{% block datatable_columns %}[
{   "data": "id",
    "width": "1px",
    "visible": false
},
{   "data": "date",
    "width": "20px",
    "render": function (data, type, row) {
        if (type !== "display") return data;
        const link = document.createElement("a");
        link.href = "/api/events/" + encodeURIComponent(row.id);
        link.textContent = data ?? "";
        return link;
    }
},
{   "data": "source",
    "width": "20px"
},
{   "data": "url",
    "render": function (data, type, row) {
        if (type !== "display") return data;
        const content = document.createElement("span");
        const title = document.createElement("strong");
        title.textContent = row.title ?? "";
        content.append(title, document.createElement("br"));

        const urlText = data ?? "";
        let url;
        try {
            url = new URL(urlText, window.location.href);
        } catch (error) {
            content.append(document.createTextNode(urlText));
            return content;
        }
        if (url.protocol !== "http:" && url.protocol !== "https:") {
            content.append(document.createTextNode(urlText));
            return content;
        }
        const link = document.createElement("a");
        link.href = url.href;
        link.textContent = urlText;
        content.append(link);
        return content;
    }
},
{ "data": "title",
  "visible": false,
  "width": "0px"
},
{ "data": "place_id",
  "visible": false,
  "width": "0px"
},
{ "data": "source_id",
  "visible": false,
  "width": "0px"
},
{ "data": "task_id",
  "visible": false,
  "width": "0px"
},
{ "data": "meta",
  "visible": false,
  "width": "0px"
}
]{% endblock datatable_columns %}

